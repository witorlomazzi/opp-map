<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Opp Map User</label>
    <description>Grants field access and Apex entry points for the Opportunity Map component.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>OpportunityMapController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <objectPermissions>
        <object>Saved_Map_View__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <field>Opportunity.Tag__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Account.Geocode_Cache_Timestamp__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Saved_Map_View__c.Filters_JSON__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
</PermissionSet>
